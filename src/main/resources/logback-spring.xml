<configuration>
    <!-- Un solo appender de consola: no hay ambientes ni ELK que consuma un formato
         JSON distinto, y Railway (como cualquier PaaS) captura stdout, no lee archivos —
         de ahí que tampoco haya un appender a disco. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{request_id}] [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
